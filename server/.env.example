PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Paste the connection string from MongoDB Atlas > Database > Connect > Drivers.
# Replace <db_password> with the database user's password; URL-encode special characters.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/college_sports_tournament?retryWrites=true&w=majority

# Use a long random secret (32+ characters). Do not share or commit this file.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# First administrator account created automatically on first successful database connection.
ADMIN_NAME=College Tournament Administrator
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Optional email announcement delivery (Gmail requires an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-account@example.com
SMTP_PASS=your-google-app-password
MAIL_FROM=College Sports Office <your-sending-account@example.com>
